# Copy to .env and adjust per environment.
# Only variables prefixed with VITE_ are exposed to the browser bundle -
# never put secrets in this file.

# Relative path: Vite proxies /api to the Laravel server (see vite.config.js), so the
# browser only ever talks to http://127.0.0.1:5173 and CORS is not involved in dev.
# Set a full URL (e.g. https://api.myitronline.com/api) to call the API directly.
VITE_API_BASE_URL=/api

# Where Vite forwards /api during development. Not exposed to the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:5555

# Request timeout in milliseconds.
VITE_API_TIMEOUT=15000

VITE_APP_NAME=MyITRonline
